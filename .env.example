# Frontend publico (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
VITE_AI_PROVIDER=auto
VITE_AI_MAX_TOKENS=700
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Acessos rapidos de demonstracao (somente dev local; ignorados no build de producao)
# Nao use credenciais reais em ambientes compartilhados.
VITE_DEMO_LOGIN_ENABLED=false
VITE_DEMO_DOCTOR_EMAIL=
VITE_DEMO_DOCTOR_PASSWORD=
VITE_DEMO_SECRETARY_EMAIL=
VITE_DEMO_SECRETARY_PASSWORD=
VITE_DEMO_MANAGER_EMAIL=
VITE_DEMO_MANAGER_PASSWORD=
VITE_DEMO_PATIENT_EMAIL=
VITE_DEMO_PATIENT_PASSWORD=

# Supabase Edge Functions / secrets server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ALLOWED_ORIGIN=

# IA server-side
# Use AI_PROVIDER=gemini com GEMINI_API_KEY/GEMINI_MODEL, ou openai com AI_API_KEY/AI_MODEL.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# SMS server-side
SMS_API_URL=
SMS_API_KEY=
