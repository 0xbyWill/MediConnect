# Frontend publico (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development

# Modo direto da IA (recomendado — NÃO precisa de Edge Functions do Supabase para IA)
# A chave fica no bundle do frontend (VITE_*). Restrinja por domínio e cota no Google AI Studio.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# Biblioteca Farmacológica — modo direto no navegador (padrão, sem Supabase)
# Bulário/ANVISA usam proxy /api/anvisa no Vite dev/preview. OpenFDA funciona direto.
# Defina true apenas se a Edge Function medication-library estiver deployada.
VITE_MEDICATION_USE_SUPABASE=false
VITE_OPENFDA_API_KEY=
# Opcional: URL de proxy reverso para consultas.anvisa.gov.br em produção (ex.: https://seu-dominio/api/anvisa)
VITE_ANVISA_PROXY_BASE=

# Acessos rapidos de demonstracao (somente dev local; ignorados no build de producao)
# Não use credenciais reais em ambientes compartilhados.
VITE_DEMO_LOGIN_ENABLED=false
VITE_DEMO_DOCTOR_EMAIL=
VITE_DEMO_DOCTOR_PASSWORD=
VITE_DEMO_SECRETARY_EMAIL=
VITE_DEMO_SECRETARY_PASSWORD=
VITE_DEMO_MANAGER_EMAIL=
VITE_DEMO_MANAGER_PASSWORD=
VITE_DEMO_PATIENT_EMAIL=
VITE_DEMO_PATIENT_PASSWORD=

# Supabase Edge Functions / secrets server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ALLOWED_ORIGIN=

# IA server-side
# Use AI_PROVIDER=gemini com GEMINI_API_KEY/GEMINI_MODEL, ou openai com AI_API_KEY/AI_MODEL.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Biblioteca Farmacológica (Edge Function medication-library)
# Bulário/ANVISA consultas públicas não exigem token; gateway oficial usa bearer.
ANVISA_API_TOKEN=
ANVISA_API_BASE=https://api-gateway.prd.apps.anvisa.gov.br/consultas-externas-api
OPENFDA_API_KEY=
WHITEBOOK_API_BASE=https://api.whitebook.com.br
WHITEBOOK_API_KEY=

# SMS server-side
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_PROVIDER=
SMS_SENDER_ID=
SMS_CRON_SECRET=
SMS_CLINIC_NAME=MediConnect
SMS_CLINIC_UNIT=
